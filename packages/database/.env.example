# ==============================================================================
# WATCHTUBE DATABASE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env in packages/database/ or provide it in your shell environment.
#
# RUNTIME LOADING NOTE:
# Prisma CLI (@prisma/client / prisma) automatically looks for and loads .env files
# from the working directory and parent directories when running CLI commands.
#
# ALL VALUES SHOWN BELOW ARE SAFE ILLUSTRATIVE PLACEHOLDERS.
# DO NOT COMMIT REAL SECRETS OR PRODUCTION CREDENTIALS TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# DATABASE CONNECTION (POSTGRESQL)
# ------------------------------------------------------------------------------
# DATABASE_URL (Required): PostgreSQL connection URI referenced by schema.prisma.
# Required by Prisma commands:
#   - pnpm --filter @watchtube/database db:generate (prisma generate)
#   - pnpm --filter @watchtube/database db:push (prisma db push)
#   - npx prisma migrate dev
#   - npx prisma studio
#
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/watchtube?schema=public"
