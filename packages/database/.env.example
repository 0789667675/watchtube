# ==============================================================================
# WATCHTUBE DATABASE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env in packages/database/ or provide it in your shell environment.
# This file is the separately controlled local database-owner workflow; do not copy
# these owner URLs into API or worker runtime environments.
#
# RUNTIME LOADING NOTE:
# The guarded package scripts load only this package-local .env. The Prisma schema
# consumes WATCHTUBE_DATABASE_URL and WATCHTUBE_DIRECT_URL; the guard maps the
# owner-only DATABASE_URL values below only after verifying both hosts are loopback.
#
# ALL VALUES SHOWN BELOW ARE SAFE ILLUSTRATIVE PLACEHOLDERS.
# DO NOT COMMIT REAL SECRETS OR PRODUCTION CREDENTIALS TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# DATABASE CONNECTION (POSTGRESQL)
# ------------------------------------------------------------------------------
# DATABASE_URL (Required): Owner-controlled PostgreSQL URL used by the guarded
# migration and schema scripts. Do not use the runtime application role here.
# Required by Prisma commands:
#   - pnpm --filter @watchtube/database db:push (prisma db push)
#   - pnpm --filter @watchtube/database db:migrate (prisma migrate dev)
#   - pnpm --filter @watchtube/database db:status (prisma migrate status)
# The guarded db:generate command uses an inert loopback URL and does not connect.
#
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://<USER>:<PASSWORD>@127.0.0.1:5432/watchtube?schema=public"

# DATABASE_URL_UNPOOLED (Required): Owner-controlled direct URL for Prisma tooling.
# For local PostgreSQL this can be the same as DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://<USER>:<PASSWORD>@127.0.0.1:5432/watchtube?schema=public"

# The database scripts load only this package-local .env and reject non-loopback
# hosts before launching Prisma. Raw Prisma CLI commands cannot use the root
# DATABASE_URL because the schema requires the separate WATCHTUBE_* variables.
# Restrict the ACL on a real local .env file to the developer account and SYSTEM.
