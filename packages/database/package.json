{
  "name": "@watchtube/database",
  "version": "1.0.0",
  "description": "Prisma client and database access layer for WatchTube",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "db:generate": "node scripts/prisma-local.cjs generate",
    "db:push": "node scripts/prisma-local.cjs db push",
    "db:migrate": "node scripts/prisma-local.cjs migrate dev",
    "db:status": "node scripts/prisma-local.cjs migrate status",
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "node --test tests/prisma-local-guard.test.cjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prisma": "^5.22.0",
    "typescript": "^5.6.0"
  }
}
