generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  VIEWER
  CREATOR
  MODERATOR
  ADMIN
}

enum UserStatus {
  GOOD_STANDING
  WARNING
  RESTRICTED
  SUSPENDED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String
  role         Role       @default(VIEWER)
  status       UserStatus @default(GOOD_STANDING)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  channels     Channel[]
  likes        VideoLike[]
  subscriptions Subscription[] @relation("UserSubscriptions")
  comments     Comment[]
  watchHistory WatchHistory[]
  viewEvents   VideoViewEvent[]
  reports      Report[] @relation("UserReports")
  claims       CopyrightClaim[] @relation("UserClaims")
  strikes      UserStrike[]
}

model Channel {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id])
  handle          String   @unique
  name            String
  description     String?
  avatarUrl       String?
  bannerUrl       String?
  subscriberCount Int      @default(0)
  isVerified      Boolean  @default(false)
  createdAt       DateTime @default(now())
  videos          Video[]
  transactions    WalletTransaction[]
  adEvents        AdEvent[]
  subscribers     Subscription[] @relation("ChannelSubscribers")
  isMonetized     Boolean @default(false)
  wtppApplication WtppApplication?
}

enum VideoStatus {
  DRAFT
  UPLOADING
  PROCESSING
  READY
  REJECTED
}

enum Visibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

model Video {
  id                 String       @id @default(uuid()) @db.Uuid
  channelId          String       @db.Uuid
  channel            Channel      @relation(fields: [channelId], references: [id])
  title              String
  description        String?
  rawStorageKey      String
  status             VideoStatus  @default(DRAFT)
  visibility         Visibility   @default(PRIVATE)
  duration           Float?
  viewsCount         Int          @default(0)
  thumbnailUrl       String?
  lowBandwidthReady  Boolean      @default(false)
  createdAt          DateTime     @default(now())
  publishedAt        DateTime?
  variants           VideoVariant[]
  likes              VideoLike[]
  comments           Comment[]
  watchHistory       WatchHistory[]
  viewEvents         VideoViewEvent[]
  adEvents           AdEvent[]
  escrowHolds        EscrowHold[]
  copyrightClaims    CopyrightClaim[]
}

model VideoVariant {
  id          String   @id @default(uuid()) @db.Uuid
  videoId     String   @db.Uuid
  video       Video    @relation(fields: [videoId], references: [id])
  resolution  String
  bitrate     Int
  playlistUrl String
}

enum TransactionType {
  HOLD
  REVENUE_CREDIT
  PAYOUT
  ADJUSTMENT
}

model WalletTransaction {
  id               String          @id @default(uuid()) @db.Uuid
  channelId        String          @db.Uuid
  channel          Channel         @relation(fields: [channelId], references: [id])
  transactionType  TransactionType
  amountCents      BigInt
  balanceAfterCents BigInt
  referenceId      String          @unique
  createdAt        DateTime        @default(now())
  status           WalletStatus    @default(PENDING)
}

model VideoLike {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  videoId   String   @db.Uuid
  video     Video    @relation(fields: [videoId], references: [id])
  isDislike Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, videoId])
}

model Subscription {
  id           String   @id @default(uuid()) @db.Uuid
  subscriberId String   @db.Uuid
  subscriber   User     @relation("UserSubscriptions", fields: [subscriberId], references: [id])
  channelId    String   @db.Uuid
  channel      Channel  @relation("ChannelSubscribers", fields: [channelId], references: [id])
  createdAt    DateTime @default(now())

  @@unique([subscriberId, channelId])
}

model Comment {
  id         String    @id @default(uuid()) @db.Uuid
  videoId    String    @db.Uuid
  video      Video     @relation(fields: [videoId], references: [id])
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id])
  parentId   String?   @db.Uuid
  parent     Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies    Comment[] @relation("CommentReplies")
  content    String
  likesCount Int       @default(0)
  isPinned   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model WatchHistory {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @db.Uuid
  user                User     @relation(fields: [userId], references: [id])
  videoId             String   @db.Uuid
  video               Video    @relation(fields: [videoId], references: [id])
  lastPositionSeconds Float
  completed           Boolean  @default(false)
  updatedAt           DateTime @updatedAt

  @@unique([userId, videoId])
}

model VideoViewEvent {
  id                   String   @id @default(uuid()) @db.Uuid
  videoId              String   @db.Uuid
  video                Video    @relation(fields: [videoId], references: [id])
  userId               String?  @db.Uuid
  user                 User?    @relation(fields: [userId], references: [id])
  sessionId            String
  watchDurationSeconds Float
  isValidView          Boolean  @default(false)
  ipHash               String
  createdAt            DateTime @default(now())
}

enum WalletStatus {
  PENDING
  AVAILABLE
  PAID
  FAILED
}

enum ReportReason {
  SPAM
  HARASSMENT
  COPYRIGHT
  HATE_SPEECH
  MISLEADING
  OTHER
}

enum ReportTargetType {
  VIDEO
  COMMENT
  CHANNEL
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  ACTION_TAKEN
  DISMISSED
}

model Report {
  id          String           @id @default(uuid()) @db.Uuid
  reporterId  String?          @db.Uuid
  reporter    User?            @relation("UserReports", fields: [reporterId], references: [id])
  targetType  ReportTargetType
  targetId    String           @db.Uuid
  reason      ReportReason
  details     String?
  status      ReportStatus     @default(OPEN)
  createdAt   DateTime         @default(now())
  resolvedAt  DateTime?
}

enum CopyrightClaimStatus {
  OPEN
  UNDER_REVIEW
  APPROVED_TAKEDOWN
  REJECTED
  DISPUTED
}

model CopyrightClaim {
  id          String               @id @default(uuid()) @db.Uuid
  claimantId  String               @db.Uuid
  claimant    User                 @relation("UserClaims", fields: [claimantId], references: [id])
  videoId     String               @db.Uuid
  video       Video                @relation(fields: [videoId], references: [id])
  description String
  proofUrl    String?
  status      CopyrightClaimStatus @default(OPEN)
  createdAt   DateTime             @default(now())
  resolvedAt  DateTime?
  escrowHold  EscrowHold?
}

enum StrikeType {
  WARNING
  VIDEO_REMOVAL
  MONETIZATION_HOLD
  SUSPENSION
}

model UserStrike {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @db.Uuid
  user       User       @relation(fields: [userId], references: [id])
  reason     String
  strikeType StrikeType
  expiresAt  DateTime
  createdAt  DateTime   @default(now())
}

enum WtppApplicationStatus {
  NOT_APPLIED
  PENDING
  APPROVED
  REJECTED
}

model WtppApplication {
  id                   String                @id @default(uuid()) @db.Uuid
  channelId            String                @unique @db.Uuid
  channel              Channel               @relation(fields: [channelId], references: [id])
  status               WtppApplicationStatus @default(PENDING)
  channelWatchHours    Float
  subscriberCount      Int
  taxId                String?
  nationalIdOrPassport String?
  reviewerNotes        String?
  submittedAt          DateTime              @default(now())
  reviewedAt           DateTime?
}


enum AdEventType {
  AD_REQUEST
  AD_SERVED
  AD_VIEWABLE
  AD_CLICK
}

model AdEvent {
  id                String      @id @default(uuid()) @db.Uuid
  videoId           String      @db.Uuid
  video             Video       @relation(fields: [videoId], references: [id])
  channelId         String      @db.Uuid
  channel           Channel     @relation(fields: [channelId], references: [id])
  eventType         AdEventType
  provider          String
  grossRevenueCents BigInt      @default(0)
  ipHash            String
  createdAt         DateTime    @default(now())
}

enum ReconStatus {
  ESTIMATED
  REPORTED
  FINALIZED
  DISTRIBUTED
}

model RevenueReconciliation {
  id                        String      @id @default(uuid()) @db.Uuid
  monthYear                 String
  grossProviderRevenueCents BigInt
  platformShareCents        BigInt
  creatorPoolCents          BigInt
  status                    ReconStatus @default(ESTIMATED)
  finalizedAt               DateTime?
  createdAt                 DateTime    @default(now())
}

enum EscrowStatus {
  HELD
  RELEASED_TO_CREATOR
  TRANSFERRED_TO_CLAIMANT
  REFUNDED
}

model EscrowHold {
  id              String         @id @default(uuid()) @db.Uuid
  videoId         String         @db.Uuid
  video           Video          @relation(fields: [videoId], references: [id])
  claimId         String         @unique @db.Uuid
  claim           CopyrightClaim @relation(fields: [claimId], references: [id])
  heldAmountCents BigInt         @default(0)
  status          EscrowStatus   @default(HELD)
  createdAt       DateTime       @default(now())
  resolvedAt      DateTime?
}
