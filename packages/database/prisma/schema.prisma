generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  VIEWER
  CREATOR
  MODERATOR
  ADMIN
}

enum UserStatus {
  GOOD_STANDING
  WARNING
  RESTRICTED
  SUSPENDED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String
  role         Role       @default(VIEWER)
  status       UserStatus @default(GOOD_STANDING)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  channels     Channel[]
  likes        VideoLike[]
  subscriptions Subscription[] @relation("UserSubscriptions")
  comments     Comment[]
  watchHistory WatchHistory[]
  viewEvents   VideoViewEvent[]
}

model Channel {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id])
  handle          String   @unique
  name            String
  description     String?
  avatarUrl       String?
  bannerUrl       String?
  subscriberCount Int      @default(0)
  isVerified      Boolean  @default(false)
  createdAt       DateTime @default(now())
  videos          Video[]
  transactions    WalletTransaction[]
  subscribers     Subscription[] @relation("ChannelSubscribers")
}

enum VideoStatus {
  DRAFT
  UPLOADING
  PROCESSING
  READY
  REJECTED
}

enum Visibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

model Video {
  id                 String       @id @default(uuid()) @db.Uuid
  channelId          String       @db.Uuid
  channel            Channel      @relation(fields: [channelId], references: [id])
  title              String
  description        String?
  rawStorageKey      String
  status             VideoStatus  @default(DRAFT)
  visibility         Visibility   @default(PRIVATE)
  duration           Float?
  viewsCount         Int          @default(0)
  thumbnailUrl       String?
  lowBandwidthReady  Boolean      @default(false)
  createdAt          DateTime     @default(now())
  publishedAt        DateTime?
  variants           VideoVariant[]
  likes              VideoLike[]
  comments           Comment[]
  watchHistory       WatchHistory[]
  viewEvents         VideoViewEvent[]
}

model VideoVariant {
  id          String   @id @default(uuid()) @db.Uuid
  videoId     String   @db.Uuid
  video       Video    @relation(fields: [videoId], references: [id])
  resolution  String
  bitrate     Int
  playlistUrl String
}

enum TransactionType {
  HOLD
  REVENUE_CREDIT
  PAYOUT
  ADJUSTMENT
}

model WalletTransaction {
  id               String          @id @default(uuid()) @db.Uuid
  channelId        String          @db.Uuid
  channel          Channel         @relation(fields: [channelId], references: [id])
  transactionType  TransactionType
  amountCents      BigInt
  balanceAfterCents BigInt
  referenceId      String          @unique
  createdAt        DateTime        @default(now())
  status           WalletStatus    @default(PENDING)
}

model VideoLike {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  videoId   String   @db.Uuid
  video     Video    @relation(fields: [videoId], references: [id])
  isDislike Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, videoId])
}

model Subscription {
  id           String   @id @default(uuid()) @db.Uuid
  subscriberId String   @db.Uuid
  subscriber   User     @relation("UserSubscriptions", fields: [subscriberId], references: [id])
  channelId    String   @db.Uuid
  channel      Channel  @relation("ChannelSubscribers", fields: [channelId], references: [id])
  createdAt    DateTime @default(now())

  @@unique([subscriberId, channelId])
}

model Comment {
  id         String    @id @default(uuid()) @db.Uuid
  videoId    String    @db.Uuid
  video      Video     @relation(fields: [videoId], references: [id])
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id])
  parentId   String?   @db.Uuid
  parent     Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies    Comment[] @relation("CommentReplies")
  content    String
  likesCount Int       @default(0)
  isPinned   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model WatchHistory {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @db.Uuid
  user                User     @relation(fields: [userId], references: [id])
  videoId             String   @db.Uuid
  video               Video    @relation(fields: [videoId], references: [id])
  lastPositionSeconds Float
  completed           Boolean  @default(false)
  updatedAt           DateTime @updatedAt

  @@unique([userId, videoId])
}

model VideoViewEvent {
  id                   String   @id @default(uuid()) @db.Uuid
  videoId              String   @db.Uuid
  video                Video    @relation(fields: [videoId], references: [id])
  userId               String?  @db.Uuid
  user                 User?    @relation(fields: [userId], references: [id])
  sessionId            String
  watchDurationSeconds Float
  isValidView          Boolean  @default(false)
  ipHash               String
  createdAt            DateTime @default(now())
}

enum WalletStatus {
  PENDING
  AVAILABLE
  PAID
  FAILED
}
