# ==============================================================================
# WATCHTUBE MEDIA WORKER — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env in apps/worker/ or provide these variables in your environment.
#
# RUNTIME LOADING NOTE:
# The worker does not call dotenv at runtime. Supply environment variables via shell
# export, container orchestrator (Docker, Render, Kubernetes), or `node --env-file=.env`.
#
# ALL VALUES SHOWN BELOW ARE SAFE ILLUSTRATIVE PLACEHOLDERS.
# DO NOT COMMIT REAL SECRETS OR PRODUCTION CREDENTIALS TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
# NODE_ENV (Optional): Application runtime environment ('development' | 'production' | 'test').
# Default: development
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. DATABASE PERSISTENCE (PRISMA)
# ------------------------------------------------------------------------------
# DATABASE_URL (Required): Connection URI for PostgreSQL.
# The worker updates video records (status: READY/REJECTED, duration, thumbnailUrl)
# and registers transcoded VideoVariant renditions (360p, 720p, 1080p).
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/watchtube?schema=public"

# ------------------------------------------------------------------------------
# 3. BACKGROUND QUEUE (REDIS / BULLMQ)
# ------------------------------------------------------------------------------
# REDIS_URL (Optional): Full Redis connection URI (e.g., redis://user:password@host:port).
# Takes precedence over REDIS_HOST / REDIS_PORT when specified.
REDIS_URL="redis://127.0.0.1:6379"

# REDIS_HOST (Optional): Hostname or IP address of the Redis server.
# Default: 127.0.0.1
REDIS_HOST="127.0.0.1"

# REDIS_PORT (Optional): Port number of the Redis server.
# Default: 6379
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 4. CLOUDFLARE R2 OBJECT STORAGE (S3-COMPATIBLE)
# ------------------------------------------------------------------------------
# CLOUDFLARE_ACCOUNT_ID (Required): Cloudflare account identifier.
# Forms the endpoint: https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"

# R2_ACCESS_KEY_ID (Required): S3-compatible access key ID for R2 bucket operations.
R2_ACCESS_KEY_ID="your_r2_access_key_id"

# R2_SECRET_ACCESS_KEY (Required): S3-compatible secret access key for R2.
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"

# R2_BUCKET_RAW (Optional): Bucket from which the worker downloads the raw source video.
# Default fallback in code: 'watchtube-raw-uploads'
R2_BUCKET_RAW="watchtube-raw-uploads"

# R2_BUCKET_PUBLIC (Optional): Bucket to which the worker uploads HLS playlists (.m3u8),
# video segments (.ts), poster images, and preview thumbnails.
# Default fallback in code: 'watchtube-media-public'
R2_BUCKET_PUBLIC="watchtube-media-public"

# R2_PUBLIC_DOMAIN / R2_BUCKET_PUBLIC_URL (Required): Public base domain or Cloudflare
# CDN URL used to construct streaming URLs for playlists and thumbnails.
# Accepts either variable (or space-separated list, first taken).
R2_PUBLIC_DOMAIN="https://pub-xxxxxxxx.r2.dev"
R2_BUCKET_PUBLIC_URL="pub-xxxxxxxx.r2.dev"

# ------------------------------------------------------------------------------
# 5. WORKER TEMPORARY PROCESSING STORAGE
# ------------------------------------------------------------------------------
# WATCHTUBE_TEMP_DIR (Optional): Custom base directory for temporary media processing.
# If omitted, defaults to a platform-safe location via os.tmpdir():
#   - Windows: %LOCALAPPDATA%\Temp\watchtube or system temp
#   - Linux/macOS: /tmp/watchtube or system temp
# Safety validation: Must resolve to a valid non-root path (cannot be '/' or 'C:\').
# Each transcode job generates an isolated unique attempt directory via fs.mkdtemp()
# inside this base directory, which is strictly verified for path containment and
# cleaned up in a finally block without affecting other concurrent jobs or retries.
# WATCHTUBE_TEMP_DIR="/tmp/watchtube"
