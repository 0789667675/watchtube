{
  "extends": "@watchtube/config/tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist-test",
    "rootDir": ".",
    "module": "commonjs",
    "moduleResolution": "node",
    "types": ["node"]
  },
  "include": [
    "src/middleware/cors.ts",
    "src/config/serviceEndpointSafety.ts",
    "src/routes/channel.route.ts",
    "src/routes/channel-image-upload.route.ts",
    "src/routes/video-upload.route.ts",
    "src/routes/creator-comments.route.ts",
    "src/services/channel-image.service.ts",
    "src/services/storage.service.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "dist-test"]
}
