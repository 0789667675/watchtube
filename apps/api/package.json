{
  "name": "@watchtube/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/tests/video-upload.route.test.js dist-test/tests/creator-comments.route.test.js dist-test/tests/channel.route.test.js dist-test/tests/channel-image-upload.route.test.js dist-test/tests/channel-image-storage.test.js dist-test/tests/channel-image-validation.test.js dist-test/tests/service-endpoint-safety.test.js",
    "dev": "node --env-file-if-exists=.env scripts/dev-local.cjs",
    "dev:api": "node --env-file-if-exists=.env scripts/dev-local.cjs",
    "start": "node --env-file-if-exists=.env dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@watchtube/database": "workspace:*",
    "@watchtube/types": "workspace:*",
    "bcryptjs": "^3.0.3",
    "bullmq": "^4.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.18.0",
    "helmet": "^7.0.0",
    "ioredis": "^5.0.0",
    "jsonwebtoken": "^9.0.3",
    "sharp": "^0.35.5",
    "uuid": "^14.0.3",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@types/uuid": "^11.0.0",
    "@watchtube/config": "workspace:*",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0"
  }
}
