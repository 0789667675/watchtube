# ==============================================================================
# WATCHTUBE API — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env in apps/api/ or provide these variables in your environment.
#
# RUNTIME LOADING NOTE:
# The API does not call dotenv at runtime. When running `node dist/index.js` or
# development scripts, supply environment variables via shell export, container
# environment, or `node --env-file=.env`.
#
# ALL VALUES SHOWN BELOW ARE SAFE ILLUSTRATIVE PLACEHOLDERS.
# DO NOT COMMIT REAL SECRETS OR PRODUCTION CREDENTIALS TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME
# ------------------------------------------------------------------------------
# PORT (Optional): Port number on which the Express REST API listens.
# Default: 3001
PORT=3001

# NODE_ENV (Optional): Application runtime environment ('development' | 'production' | 'test').
# In 'production':
#   - Authentication cookies are set with secure: true (HTTPS only).
#   - JWT_SECRET validation enforces strict security: missing or default keys fail startup.
# Default: development
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. DATABASE PERSISTENCE (PRISMA)
# ------------------------------------------------------------------------------
# DATABASE_URL (Required): Connection URI for the PostgreSQL database instance.
# Used by @watchtube/database Prisma Client for all API data persistence.
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/watchtube?schema=public"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# JWT_SECRET (Required in production): Secret cryptographic key used to sign and verify
# JSON Web Tokens. In production (NODE_ENV=production), startup aborts immediately if
# unset, shorter than 32 characters, or matching common insecure defaults.
# In development, falls back to 'supersecret' with a loud console security warning.
JWT_SECRET="replace_with_a_secure_random_jwt_secret_at_least_32_characters"

# ------------------------------------------------------------------------------
# 4. BACKGROUND QUEUE & CACHE (REDIS / BULLMQ)
# ------------------------------------------------------------------------------
# REDIS_URL (Optional): Full Redis connection URI (e.g., redis://user:password@host:port).
# Takes precedence over REDIS_HOST / REDIS_PORT when specified.
REDIS_URL="redis://127.0.0.1:6379"

# REDIS_HOST (Optional): Hostname or IP address of the Redis server.
# Default: 127.0.0.1
REDIS_HOST="127.0.0.1"

# REDIS_PORT (Optional): Port number of the Redis server.
# Default: 6379
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 5. CLOUDFLARE R2 OBJECT STORAGE (S3-COMPATIBLE)
# ------------------------------------------------------------------------------
# CLOUDFLARE_ACCOUNT_ID (Required for storage): Cloudflare account identifier.
# Forms the endpoint: https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"

# R2_ACCESS_KEY_ID (Required for storage): S3-compatible access key ID for R2 bucket access.
R2_ACCESS_KEY_ID="your_r2_access_key_id"

# R2_SECRET_ACCESS_KEY (Required for storage): S3-compatible secret access key for R2.
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"

# R2_BUCKET_RAW (Required for storage): Bucket name where raw client video uploads are stored.
R2_BUCKET_RAW="watchtube-raw-uploads"
