# ==============================================================================
# WATCHTUBE API — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env in apps/api/ or provide these variables in your environment.
#
# RUNTIME LOADING NOTE:
# The API dev/start scripts load only this optional apps/api/.env file.
# Explicit shell environment variables take precedence; the monorepo root .env
# is intentionally not loaded by local API development scripts.
# Production deployments can inject configuration through the runtime environment.
#
# ALL VALUES SHOWN BELOW ARE SAFE ILLUSTRATIVE PLACEHOLDERS.
# DO NOT COMMIT REAL SECRETS OR PRODUCTION CREDENTIALS TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME
# ------------------------------------------------------------------------------
# API_PORT (Optional): Local API port used by the API and Vite development proxy.
# Default: 3001
API_PORT=3001
# Outside local-only development, deployment PORT takes precedence.

# NODE_ENV (Optional): Application runtime environment ('development' | 'production' | 'test').
# In 'production':
#   - Authentication cookies are set with secure: true (HTTPS only).
#   - JWT_SECRET validation enforces strict security: missing or default keys fail startup.
# Default: development
NODE_ENV=development

# API_ALLOWED_ORIGINS: Comma-separated exact HTTP(S) Viewer origins.
# Credentialed requests are enabled only for these origins; wildcard origins are rejected.
# Development also permits the standard local Vite origins. Production must list the
# deployed Viewer origin, including when the Viewer and API share an origin.
API_ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# 2. DATABASE PERSISTENCE (PRISMA)
# ------------------------------------------------------------------------------
# DATABASE_URL (Optional for local-only API startup; required for database-backed routes):
# Connection URI for the PostgreSQL database instance.
# Local development entrypoints require the host to be loopback.
# Used by @watchtube/database Prisma Client for all API data persistence.
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/watchtube?schema=public"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# JWT_SECRET (Required in production): Secret cryptographic key used to sign and verify
# JSON Web Tokens. In production (NODE_ENV=production), startup aborts immediately if
# unset, shorter than 32 characters, or matching common insecure defaults.
# In development, falls back to 'supersecret' with a loud console security warning.
JWT_SECRET="replace_with_a_secure_random_jwt_secret_at_least_32_characters"

# ------------------------------------------------------------------------------
# 4. BACKGROUND QUEUE & CACHE (REDIS / BULLMQ)
# ------------------------------------------------------------------------------
# REDIS_URL (Optional): Full Redis connection URI (e.g., redis://user:password@host:port).
# Takes precedence over REDIS_HOST / REDIS_PORT when specified.
REDIS_URL="redis://127.0.0.1:6379"

# REDIS_HOST (Optional): Hostname or IP address of the Redis server.
# Default: 127.0.0.1
REDIS_HOST="127.0.0.1"

# REDIS_PORT (Optional): Port number of the Redis server.
# Default: 6379
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 5. CLOUDFLARE R2 OBJECT STORAGE (S3-COMPATIBLE)
# ------------------------------------------------------------------------------
# CLOUDFLARE_ACCOUNT_ID (Required for storage): Cloudflare account identifier.
# Forms the endpoint: https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
# Use the existing account and buckets; do not create or rename production buckets.
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
# Private source and processing bucket. The API needs object read/write/list access.
R2_BUCKET_RAW="watchtube-raw-uploads"
# Public delivery bucket. The API needs object write/list/delete access; copying also
# requires read access to source objects in R2_BUCKET_RAW.
R2_BUCKET_PUBLIC="watchtube-media-public"
# Public HTTPS base URL for R2_BUCKET_PUBLIC. This must point at the configured public
# bucket or CDN; a syntactically valid URL does not prove that the bucket is reachable.
R2_PUBLIC_DOMAIN="https://your-public-domain.example"
R2_BUCKET_PUBLIC_URL="https://your-public-domain.example"
