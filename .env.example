# ==============================================================================
# WATCHTUBE MONOREPO — MASTER ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# This template documents all environment variables used across the WatchTube
# monorepo workspaces (@watchtube/api, @watchtube/worker, @watchtube/database).
#
# RUNTIME ENVIRONMENT LOADING NOTES:
# - apps/api and apps/worker: Do NOT bundle runtime 'dotenv'. In production or local
#   development, inject variables via the execution shell, container orchestrator (Docker,
#   Kubernetes, Render), process manager (PM2), or Node.js flag (node --env-file=.env).
# - packages/database: Prisma CLI natively detects and loads .env from the working
#   directory or monorepo root for commands like `prisma db push` and `prisma generate`.
#
# ALL VALUES SHOWN BELOW ARE SAFE ILLUSTRATIVE PLACEHOLDERS.
# DO NOT COMMIT REAL SECRETS OR CREDENTIALS TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Used by: apps/api, apps/worker, packages/database)
# ------------------------------------------------------------------------------
# PostgreSQL connection string for Prisma ORM.
# Required by:
#   - packages/database (schema.prisma, migrations, db push)
#   - apps/api (API PrismaClient queries)
#   - apps/worker (Worker PrismaClient status & variant updates)
DATABASE_URL="postgresql://<USER>:<PASSWORD>@localhost:5432/watchtube?schema=public"

# ------------------------------------------------------------------------------
# 2. API SERVER RUNTIME (Used by: apps/api)
# ------------------------------------------------------------------------------
# Port number for the Express REST API.
PORT=4000

# Runtime environment ('development' | 'production' | 'test').
# In 'production':
#   - Authentication cookies are set with secure: true (HTTPS only).
#   - JWT_SECRET validation enforces strict security: missing or default keys fail startup.
NODE_ENV=development

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (Used by: apps/api)
# ------------------------------------------------------------------------------
# Secret key used to sign and verify JWT authentication tokens.
# Production requirement: Must be a non-default secret at least 32 characters long.
# In production, startup immediately aborts if unset or set to an insecure default.
# In development, falls back to 'supersecret' with a loud console security warning.
JWT_SECRET="replace_with_a_secure_random_jwt_secret_at_least_32_characters"

# ------------------------------------------------------------------------------
# 4. REDIS & BULLMQ BACKGROUND QUEUES (Used by: apps/api, apps/worker)
# ------------------------------------------------------------------------------
# Redis connection parameters for BullMQ 'video-transcode' queue.
# apps/api enqueues transcode tasks upon video upload verification.
# apps/worker consumes jobs to perform FFmpeg HLS transcoding.
# You can supply either a full connection URL or discrete HOST/PORT variables.
REDIS_URL="redis://127.0.0.1:6379"
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token"
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"

# ------------------------------------------------------------------------------
# 5. CLOUDFLARE R2 OBJECT STORAGE (Used by: apps/api, apps/worker)
# ------------------------------------------------------------------------------
# Cloudflare Account ID forming the S3 endpoint:
# https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"

# S3-compatible Access Key ID with Read/Write access to R2 buckets.
R2_ACCESS_KEY_ID="your_r2_access_key_id"

# S3-compatible Secret Access Key for R2.
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"

# Bucket for incoming raw video files uploaded directly by creators.
R2_BUCKET_RAW="watchtube-raw-uploads"

# Bucket for transcoded HLS master playlists, .ts segments, and thumbnails.
R2_BUCKET_PUBLIC="watchtube-media-public"

# Public domain or Cloudflare CDN URL used to serve playback streams.
# (e.g., media.watchtube.rw or pub-xxxxxx.r2.dev)
# Accepts either R2_PUBLIC_DOMAIN or R2_BUCKET_PUBLIC_URL.
R2_PUBLIC_DOMAIN="https://pub-xxxxxxxx.r2.dev"
R2_BUCKET_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

# ------------------------------------------------------------------------------
# 6. WORKER MEDIA PROCESSING STORAGE (Used by: apps/worker)
# ------------------------------------------------------------------------------
# Optional override for the local temporary scratch base directory during FFmpeg transcoding.
# When omitted, defaults cross-platform to path.join(os.tmpdir(), 'watchtube').
# Safe configuration rule: Must be a dedicated scratch directory and cannot point to the
# filesystem root ('/' or 'C:\'). Each transcode job automatically allocates an isolated
# attempt directory using fs.mkdtemp() inside this base, cleaned up upon job completion.
# WATCHTUBE_TEMP_DIR="/tmp/watchtube"
