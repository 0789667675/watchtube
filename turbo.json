{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:api": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["DATABASE_URL", "REDIS_URL", "REDIS_HOST", "REDIS_PORT", "API_PORT", "PORT"]
    },
    "dev:web": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["API_PORT", "PORT", "API_PROXY_TARGET", "WATCHTUBE_LOCAL_ONLY"]
    }
  }
}
